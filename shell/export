export LANG="zh_CN.UTF-8"
export LANGUAGE="zh_CN:en"
export PATH="$PATH:$HOME/.local/bin"

# Java 环境 (macOS / Debian)
if [[ -x /usr/libexec/java_home ]]; then
    # macOS
    export JAVA_HOME="$(/usr/libexec/java_home -v 17 2>/dev/null)"
elif [[ -d /usr/lib/jvm/default-java ]]; then
    # Debian/Ubuntu (managed by update-alternatives)
    export JAVA_HOME="/usr/lib/jvm/default-java"
fi

# Homebrew 镜像加速（仅在 Homebrew 存在时设置）
if command -v brew &>/dev/null; then
    export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles"
    export HOMEBREW_API_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles/api"
    export HOMEBREW_NO_AUTO_UPDATE=1
fi

# Homebrew Python 3 (Intel & Apple Silicon compatible)
# 使用 Homebrew 安装的 Python 3 作为默认版本
if [[ -d "${HOMEBREW_PREFIX}/opt/python3/libexec/bin" ]]; then
    export PATH="${HOMEBREW_PREFIX}/opt/python3/libexec/bin:$PATH"
fi

# 仅在 Skit1zdeMacBook-Air.local 上生效的配置
if [[ "$(hostname)" == "Skit1zdeMacBook-Air.local" ]]; then
    # 在这里添加特定于此机器的配置
    # Homebrew Node.js (version-independent path)
    # Homebrew Node.js（不含版本号的路径）
    if [[ -d "${HOMEBREW_PREFIX}/opt/node/bin" ]]; then
        export PATH="${HOMEBREW_PREFIX}/opt/node/bin:$PATH"
    fi
    [ -f "$HOME/.openclaw/completions/openclaw.zsh" ] && source "$HOME/.openclaw/completions/openclaw.zsh"
fi

# 仅在 Skit1zdeMacBook-Pro.local 上生效的配置
if [[ "$(hostname)" == "Skit1zdeMacBook-Pro.local" ]]; then
    # 在这里添加特定于此 MacBook Pro 的配置
    export ANDROID_HOME=$HOME/Library/Android/sdk
    export PATH=$PATH:$ANDROID_HOME/emulator
    export PATH=$PATH:$ANDROID_HOME/platform-tools

    # Homebrew Ruby
    export PATH="${HOMEBREW_PREFIX}/opt/ruby/bin:$PATH"
    export LDFLAGS="-L${HOMEBREW_PREFIX}/opt/ruby/lib"
    export CPPFLAGS="-I${HOMEBREW_PREFIX}/opt/ruby/include"
fi

# 强制本地流量不走代理
export no_proxy="localhost,127.0.0.1,0.0.0.0,192.168.0.0/16,10.0.0.0/8"
export NO_PROXY="localhost,127.0.0.1,0.0.0.0,192.168.0.0/16,10.0.0.0/8"